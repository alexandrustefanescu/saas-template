DATABASE_URL=postgres://saas:saas@localhost:5432/saas
HOST=0.0.0.0
PORT=8080

# even-better-auth (required)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional bootstrap admins (comma-separated better-auth user ids)
# ADMIN_USER_IDS=
# TRUSTED_ORIGINS=http://localhost:3000

# Optional ops webhook (unsigned POST on item create + POST /v1/webhooks/ping).
# Organisation endpoints in the DB are separate and receive signed item.created deliveries.
# WEBHOOK_URL=https://example.com/hooks/saas

# Rate limiting / throttling (token bucket, per client IP)
RATE_LIMIT_BURST=60
RATE_LIMIT_PERIOD_MS=1000
